# Build-time environment variables for `nuxt generate`.
# Copy to `.env` for local builds, and set the same names in the deploy
# environment (e.g. Netlify). Never commit the real `.env`.

# DatoCMS read-only API token. Used ONLY at build time by lib/datocms.js.
# Must NOT be prefixed with NUXT_ENV_ (that prefix leaks the value into the
# client bundle). Renamed from the former NUXT_ENV_DATOCMS_API_TOKEN.
DATOCMS_API_TOKEN=

# Optional DatoCMS environment (sandbox/primary). Leave blank for primary.
NUXT_ENV_DATOCMS_ENVIRONMENT=

# Canonical/base URLs used for metadata and OGP.
BASE_URL=
BASE_OGP=
